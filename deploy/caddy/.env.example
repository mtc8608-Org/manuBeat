# Skeleton — provision.sh copies this to /srv/caddy/.env (chmod 600) if absent.
# Fill on the box only; the real values never enter the repo.

# Hetzner Cloud API token (Read & Write), created in console.hetzner.com in
# the project that holds the DNS zone: project → Security → API tokens.
# NOTE: Cloud tokens are project-wide — this one can also manage the servers
# in that project. chmod 600, on-box only.
HETZNER_API_TOKEN=

# ACME account email (Let's Encrypt expiry notices)
ACME_EMAIL=

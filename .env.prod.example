# Production env template — companion to docker-compose.prod.yml.
#
# The real file lives ONLY on the box at /srv/apps/<app>/.env (chmod 600)
# plus the password manager — never in the repo. deploy/ship-app.sh copies
# this template there on first ship and then refuses to ship until every
# secret below is filled.
#
# Two kinds of values:
#   generated — create with the openssl one-liner in the comment
#   chosen    — real values you pick (admin login)

COMPOSE_PROJECT_NAME=manubeat

NODE_PORT=3000

# Python compute service (docker-network internal; fork Node callers build
# URLs as http://$PYTHON_HOST:$PYTHON_PORT — see .claude/rules/python-compute.md)
PYTHON_HOST=python
PYTHON_PORT=5000

# Database
POSTGRES_USER=postgres
POSTGRES_DB=manubeat
PG_PORT=5432
# generated: openssl rand -hex 24
POSTGRES_PASSWORD=

# Auth
# generated: openssl rand -hex 32
JWT_SECRET=
# chosen: the real admin login, seeded on first boot
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Master key for the user_secrets keychain (AES-256-GCM) — must be exactly
# 64 hex chars (32 bytes) or the backend refuses to use the keychain.
# generated: openssl rand -hex 32
SECRETS_MASTER_KEY=

# File storage (MinIO)
MINIO_USER=manubeat-minio
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_BUCKET=uploads
# generated: openssl rand -hex 24
MINIO_PASSWORD=

# Optional: AI content import (LaTeX → cards)
# ANTHROPIC_API_KEY=

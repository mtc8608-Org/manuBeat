COMPOSE_PROJECT_NAME=manubeat

NODE_PORT=3000
PWA_PORT=8100

# Python compute service (docker-network internal; Node callers build URLs as
# http://$PYTHON_HOST:$PYTHON_PORT — see .claude/rules/python-compute.md)
PYTHON_HOST=python
PYTHON_PORT=5000

# Database
POSTGRES_PASSWORD=changeme
POSTGRES_USER=postgres
POSTGRES_DB=manubeat
PG_PORT=5432
DELETE_DB=true

# Auth — set a long random string for JWT_SECRET (anything works, e.g. 32+ random characters)
JWT_SECRET=replace-this-with-a-long-random-string
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=YourPassword123

# Master key for the user_secrets keychain (AES-256-GCM) — 64 hex chars (32 bytes).
# Generate with: openssl rand -hex 32
SECRETS_MASTER_KEY=

# File storage (MinIO) — defaults work as-is for local use
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_BUCKET=uploads

# Optional: AI content import (LaTeX → cards) — get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=

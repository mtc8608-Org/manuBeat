# ── OS & editors ─────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# ── VS Code — ignore personal/generated files, keep shared project settings ──
.vscode/*
!.vscode/settings.json

# ── Environment & secrets ────────────────────────────────────
.env
.env.*
!.env.example
!.env.prod.example

# ── Node.js ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
*.log

# ── Frontend build output ────────────────────────────────────
pwa/dist/
pwa/.vite/
pwa/coverage/
pwa/cypress/screenshots/
pwa/cypress/videos/
pwa/.ionic/
pwa/android/
pwa/ios/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.pytest_cache/
htmlcov/
.coverage
*.egg-info/
.ipynb_checkpoints/
*.ipynb
# [MEDICAL] the ported model notebooks ARE tracked — they are the debugging
# surface for python/library/ (see CLAUDE.md "Cardiopulmonary model stack").
# Committed with outputs stripped; regenerate them by running, never commit outputs.
!python/run_*/*.ipynb

# ── Database & persistent storage ────────────────────────────
.persist/
# Scratch dir for the local prod-compose smoke test (stand-in for the
# on-box /srv/apps/<app>/public mount) — never committed.
/public/

# [MEDICAL] everything the notebooks generate — populations, LaTeX tables,
# figures. Sits beside python/run_*/ and is never committed.
python/notebookData/*
!python/notebookData/.gitkeep

# ── Large data files — never commit ──────────────────────────
*.pdf
*.h5
*.hdf5
*.he5

# ── Claude Code ──────────────────────────────────────────────
# Ignore personal/machine config (settings.local.json, etc.), but share
# the curated memory knowledge base, the path-gated rules, and the skills
# so others can grasp and work the system via Claude Code.
.claude/*
!.claude/memory/
!.claude/rules/
!.claude/skills/
!.claude/agents/
# ...except personal notes, personal infra and the brainstorm ledger.
# pre-deployment-todo.md is NOT excluded here: upstream hides it because a public
# framework repo should not publish a live list of its own holes, but this fork is
# private and its audit TODO commits with the repo (see skills/predeploy-audit).
.claude/memory/user-manuel.md
.claude/memory/deployment-plan.md
.claude/memory/production-walkthrough.md
.claude/memory/idea-ledger.md
